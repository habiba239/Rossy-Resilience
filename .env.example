# ── Dataset Paths ─────────────────────────────────────────────
# Set these to the root directories of each downloaded dataset

# CBIS-DDSM (mammography) — https://wiki.cancerimagingarchive.net/display/Public/CBIS-DDSM
CBIS_DDSM_PATH=data/CBIS-DDSM

# INbreast (mammography FFDM) — https://www.kaggle.com/datasets/martholi/inbreast
INBREAST_PATH=data/INbreast

# BUS-BRA (ultrasound) — https://www.kaggle.com/datasets/orvile/bus-bra-a-breast-ultrasound-dataset
BUS_BRA_PATH=data/BUS-BRA

# ── Model Paths (optional — scripts download from HF by default) ──────────────
# MAMMO_BASE_MODEL_PATH=path/to/base_mammo_3class.h5
# US_BASE_MODEL_PATH=path/to/base_us_model.keras

# ── HuggingFace Token (optional — increases rate limits) ─────────────────────
# HF_TOKEN=hf_...

# ── Mammogram Segmentation additional paths ───────────────────────────────────
# CBIS-DDSM preprocessed images (output of mammogram_preprocessing_baseline_yolo11.py)
# CBIS_TRAIN_IMGS=data/CBIS-DDSM/preprocessed/train_imgs
# CBIS_TRAIN_MASKS=data/CBIS-DDSM/preprocessed/train_masks
# CBIS_VAL_IMGS=data/CBIS-DDSM/preprocessed/val_imgs
# CBIS_VAL_MASKS=data/CBIS-DDSM/preprocessed/val_masks
# CBIS_TEST_IMGS=data/CBIS-DDSM/preprocessed/test_imgs
# CBIS_TEST_MASKS=data/CBIS-DDSM/preprocessed/test_masks

# CBIS-DDSM organized structure (Kaggle dataset: newconcept/organized-data)
# CBIS_ORGANIZED_PATH=data/CBIS-DDSM/organized

# BCDR external test dataset — https://bcdr.eu/
# BCDR_IMG_PATH=data/BCDR/original/BCDR-Original-Preprocessed-IMG
# BCDR_MSK_PATH=data/BCDR/original/BCDR-Original-Preprocessed-MSK
# BCDR_CSV_PATH=data/BCDR/original/csv

# Output directory for all training artifacts (models, logs, checkpoints)
OUTPUT_DIR=outputs
